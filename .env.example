# Application
NODE_ENV=development
PORT=3000

# Database Provider: mongo | postgres | mysql
DATABASE_USE=mysql

# SQL (required when DATABASE_USE=postgres or mysql)
DATABASE_URL=mysql://root@localhost:3306/mydb

# MongoDB (required when DATABASE_USE=mongo)
MONGO_URI=mongodb://localhost:27017/mydb

# JWT Authentication
JWT_SECRET=change-me-to-a-secure-random-secret-key-at-least-32-chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-secure-random-key-at-least-32-chars
JWT_REFRESH_EXPIRES_IN=7d

# Security
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
JSON_BODY_LIMIT=10kb
REQUEST_TIMEOUT_MS=30000

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs

# Swagger
SWAGGER_ENABLED=true
